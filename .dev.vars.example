# Copy to .dev.vars for local development. Set the same names as secrets in production
# (`wrangler secret put <NAME>`). The Deploy to Cloudflare button asks for these values.

# Optional. Shown before users connect an account and on /privacy. Leave empty for a personal
# deployment.
OPERATOR_NOTICE=

SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Settings. Locally they belong here; in production they are variables in the Cloudflare
# dashboard, not in wrangler.jsonc. Uncomment what you need. Without ALLOWED_EMAILS,
# ALLOWED_DOMAINS or ADMIN_EMAILS the app shows the setup checklist instead of the sign-in page.
# ALLOWED_EMAILS=you@example.com
# ADMIN_EMAILS=you@example.com
# ALLOWED_DOMAINS=
# ALLOWED_TENANT_IDS=
# PUBLIC_URL=
# DATA_JURISDICTION=
# MCP_ENABLED=1
# TIME_ZONE=Europe/Vienna

# Local development only: skip the provider sign-in and act as this existing user.
# Needs DEV_FAKE_CALENDARS=1 as well. Has no effect on any host other than localhost, 127.0.0.1
# and [::1], or while PUBLIC_URL names another host, such as a tunnel. Anyone who reaches the
# server acts as this user: never set it with a non-loopback listen address or behind any proxy
# or port forward (nginx, ssh -R, socat, kubectl port-forward).
# DEV_SIGN_IN_AS=you@example.com
# DEV_FAKE_CALENDARS=1
